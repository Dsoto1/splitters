        { "path": "range", "label": "Range (m)", "type": "number", "edit": true },
        { "path": "falloff.start", "label": "Falloff from (m; empty: family's)", "type": "number", "edit": true },
        { "path": "falloff.end", "label": "Falloff to (m)", "type": "number", "edit": true },
        { "path": "falloff.min", "label": "Falloff floor (share of damage)", "type": "number", "edit": true },
        { "path": "falloff.curve", "label": "Falloff curve", "type": "select", "options": ["linear", "smooth", "steep"], "edit": true },
        { "path": "headshot", "label": "Head multiplier (empty: family's)", "type": "number", "edit": true },
        { "path": "legshot", "label": "Leg multiplier (empty: family's)", "type": "number", "edit": true },
        { "path": "fireIntervalTicks", "label": "Fire interval (ticks; RPM = 3600 / ticks)", "type": "number", "edit": true },
        { "path": "reloadTicks", "label": "Reload (ticks; seconds = ticks / 60)", "type": "number", "edit": true },
        { "path": "raiseTicks", "label": "Raise (ticks; seconds = ticks / 60)", "type": "number", "edit": true },
        { "path": "magazine", "label": "Magazine", "type": "number", "edit": true },
        { "path": "reserveMax", "label": "Reserve", "type": "number", "edit": true },
        { "path": "pickupAmmo", "label": "Pickup ammo", "type": "number", "edit": true },
        { "path": "accuracy.base", "label": "Base spread (rad; empty: family's)", "type": "number", "edit": true },
        { "path": "accuracy.ads", "label": "ADS spread (multiple; empty: family's)", "type": "number", "edit": true },
        { "path": "kick.visual", "label": "Kick strength (0-1.5; empty: family's)", "type": "number", "edit": true },
        { "path": "projectile.speed", "label": "Projectile speed (m/s)", "type": "number", "edit": true },
        { "path": "projectile.splashRadius", "label": "Splash radius (m)", "type": "number", "edit": true },
        { "path": "projectile.splashDamage", "label": "Splash damage (centre)", "type": "number", "edit": true },
        { "path": "projectile.fuseSeconds", "label": "Fuse (s)", "type": "number", "edit": true },
        { "path": "heat.perShot", "label": "Heat per shot (1 = overheat)", "type": "number", "edit": true },
        { "path": "heat.coolPerTick", "label": "Cooling per tick", "type": "number", "edit": true },
        { "path": "botDesirability", "label": "Bot desirability (0-1)", "type": "number", "edit": true },
        { "path": "botRange", "label": "Bot range (m, from-to)", "type": "list", "edit": true },
        { "path": "notes.design", "label": "Design notes", "type": "longtext", "edit": true }
      ]
    },
    {
