{
  "collections": [
    {
      "id": "weapons",
      "label": "Weapons",
      "files": "content/weapons/*.json",
      "key": "id",
      "title": "displayName",
      "subtitle": "category",
      "filters": ["category", "slot", "family", "kind"],
      "fields": [
        { "path": "id", "label": "Id", "type": "text" },
        { "path": "code", "label": "Network code (never changes)", "type": "number" },
        { "path": "kind", "label": "Kind", "type": "text" },
        { "path": "view.hold.style", "label": "Hold (edited in the grip tool)", "type": "text" },
        { "path": "displayName", "label": "Name", "type": "text", "edit": true },
        { "path": "category", "label": "Category (random pickups)", "type": "select", "options": ["pistol", "smg", "rifle", "shotgun", "sniper", "explosive", "melee", "special"], "edit": true },
        { "path": "slot", "label": "Slot (0 mounted, 1-9)", "type": "number", "edit": true },
        { "path": "family", "label": "Family (gunplay defaults)", "type": "select", "options": ["pistol", "revolver", "machine_pistol", "smg", "rifle", "battle_rifle", "marksman", "precision", "lmg", "shotgun"], "edit": true },
        { "path": "view.model", "label": "Model", "type": "text", "edit": true },
        { "path": "damage", "label": "Damage (per pellet)", "type": "number", "edit": true },
