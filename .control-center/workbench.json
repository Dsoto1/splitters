        { "path": "falloff.end", "label": "Falloff to (m)", "type": "number", "edit": true },
        { "path": "falloff.min", "label": "Falloff floor (share of damage)", "type": "number", "edit": true },
        { "path": "falloff.curve", "label": "Falloff curve", "type": "select", "options": ["linear", "smooth", "steep"], "edit": true },
        { "path": "head", "label": "Head multiplier", "type": "number", "edit": true },
        { "path": "legs", "label": "Leg multiplier", "type": "number", "edit": true }
