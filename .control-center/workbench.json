      "fields": [
        { "path": "id", "label": "Id", "type": "text" },
        { "path": "code", "label": "Network code (never changes)", "type": "number" },
        { "path": "name", "label": "Name", "type": "text", "edit": true },
        { "path": "role", "label": "Role", "type": "select", "options": ["Offence", "Defence", "Support"], "edit": true },
        { "path": "blurb", "label": "Blurb (class screen)", "type": "longtext", "edit": true },
        { "path": "health", "label": "Health", "type": "number", "edit": true },
        { "path": "speed", "label": "Speed (multiple)", "type": "number", "edit": true },
        { "path": "airJumps", "label": "Extra jumps in the air", "type": "number", "edit": true },
        { "path": "weapons", "label": "Weapons (ids; the last one is held)", "type": "list", "edit": true },
        { "path": "throwable.kind", "label": "Throwable", "type": "select", "options": ["frag", "mine", "sticky", "incendiary", "toxic", "vortex", "holy", "cluster", "sheep", "airstrike", "sandbag", "dynamite"], "edit": true },
        { "path": "throwable.count", "label": "Throwable count", "type": "number", "edit": true },
