  "metadata": {
    "id": "ravenscroft_hall",
    "name": "Ravenscroft Hall",
    "author": "Tile Trigger",
    "description": "A Victorian manor on a stormy night, built from the Gothic Estate style pack: a galleried library whose chandeliers gutter as you come in, a parlour with a secret bookcase (pull the candle sconce), a study with rotten floorboards that drop you into the wine cellar and the crypt, a picture gallery with a bookshelf that will not stay put, formal gardens and a hedge maze behind iron railings, and a cemetery with its mausoleum where the crypt stairs come out.",
    "createdAt": "2026-10-23T00:00:00.000Z",
    "updatedAt": "2026-10-23T00:00:00.000Z",
    "parentId": null,
    "recommendedPlayers": {
      "min": 4,
      "max": 12
    },
    "supportedModes": [
      "core.deathmatch",
      "core.tdm"
    ]
  },
