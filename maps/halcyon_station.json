  "metadata": {
    "id": "halcyon_station",
    "name": "Halcyon Station",
    "author": "Tile Trigger",
    "description": "A research station hanging in space, built from the Orbital Station style pack: a ring of white-panelled corridors round a two-storey reactor hall in low gravity (jump up to the railgun round the glowing core), the hangar bay behind a force field that lets shots through but not people (the control room can vent it), labs that seal behind a field of their own, and an airlock out onto a floaty exterior gantry. Windows and viewports onto the stars all round.",
    "createdAt": "2026-10-23T00:00:00.000Z",
    "updatedAt": "2026-10-23T00:00:00.000Z",
    "parentId": null,
    "recommendedPlayers": {
      "min": 4,
      "max": 12
    },
    "supportedModes": [
      "core.deathmatch",
      "core.tdm",
      "core.koth"
    ]
  },
