  "metadata": {
    "id": "verdant_ziggurat",
    "name": "Verdant Ziggurat",
    "author": "Tile Trigger",
    "description": "A lost temple in a jungle clearing, built from the Jungle Ruins style pack: a stepped temple with its shrine and golden idol on top, an overgrown court and a temple gateway before it, caves to the west where the roof comes down behind you, a rock ridge with vines up to a sniper walk over the waterfall and its hidden recess, a river with a sagging rope bridge (two of its planks are rotten) and a giant tree with stairs spiralling up to a lookout.",
    "createdAt": "2026-10-23T00:00:00.000Z",
    "updatedAt": "2026-10-23T00:00:00.000Z",
    "parentId": null,
    "recommendedPlayers": {
      "min": 4,
      "max": 14
    },
    "supportedModes": [
      "core.deathmatch",
      "core.tdm",
      "core.koth"
    ]
  },
