  "metadata": {
    "id": "cedar_lane",
    "name": "Cedar Lane",
    "author": "Tile Trigger",
    "description": "A sunny afternoon on a suburban street, built from the Suburban Chaos style pack: clapboard family houses under slate gables, garages with up-and-over doors (buttons inside and keypads by the drive), a corner store and a gas station across the road, back yards with barbecues, a swimming pool, a playground and a carport. Picket fences splinter, and microwaves, barbecues, propane tanks, petrol pumps and the family cars all go off when shot.",
    "createdAt": "2026-10-23T00:00:00.000Z",
    "updatedAt": "2026-10-23T00:00:00.000Z",
    "parentId": null,
