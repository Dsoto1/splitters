  "metadata": {
    "id": "jungle_steps",
    "name": "Jungle Steps",
    "author": "ChronoSplit",
    "description": "An overgrown temple ruin split by a river gorge, made in the spirit of the classic jungle-temple bomb map. Embers camp in the south, Tide in the north. Cross by the long high bridge over the ravine (sniper rifle halfway, an 8 m fall if you get knocked off), the stone double-doors causeway in the middle, or the sunken river route through the gorge, reached by stair blocks at either end, where rockets wait in the culvert and heavy armour in the far nook.",
    "createdAt": "2026-10-23T00:00:00.000Z",
    "updatedAt": "2026-10-23T00:00:00.000Z",
    "parentId": null,
    "recommendedPlayers": {
      "min": 4,
      "max": 12
    },
    "supportedModes": [
      "core.tdm",
      "core.deathmatch"
    ]
  },
