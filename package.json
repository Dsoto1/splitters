{
  "name": "chronosplit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:server": "pnpm --filter @chronosplit/server dev",
    "dev:client": "pnpm --filter @chronosplit/client dev",
    "build": "pnpm --filter @chronosplit/client build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "bench": "pnpm --filter @chronosplit/server bench",
    "validate-map": "pnpm --filter @chronosplit/server validate-map",
    "e2e": "node e2e/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "playwright": "1.56.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
