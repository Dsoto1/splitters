{
  "name": "tiletrigger",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @tiletrigger/client dev",
    "dev:server": "pnpm --filter @tiletrigger/server dev",
    "dev:client": "pnpm --filter @tiletrigger/client dev",
    "build": "pnpm --filter @tiletrigger/client build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:changed": "vitest run --changed origin/main",
    "bench": "pnpm --filter @tiletrigger/server bench",
    "bench:96": "pnpm --filter @tiletrigger/server bench 96 60 maps/frost_basin.json --mode=core.tdm",
    "bench:96:maps": "pnpm --filter @tiletrigger/server bench 96 60 maps/norman_shores.json maps/apex_ring.json maps/capitol_mall.json maps/riot_junction.json maps/eagle_spires.json maps/shingle_point.json maps/frost_basin.json maps/primeval_park.json --mode=core.tdm",
    "bench:96:clump": "pnpm --filter @tiletrigger/server bench 96 30 maps/norman_shores.json maps/frost_basin.json maps/riot_junction.json --mode=core.tdm --warmup=10 --variants=spread,clump",
    "validate-map": "pnpm --filter @tiletrigger/server validate-map",
    "e2e": "node e2e/run.mjs",
    "e2e:changed": "node tools/ci/select.mjs --run",
    "e2e:baselines": "E2E_UPDATE_BASELINES=1 E2E_ONLY=visual node e2e/run.mjs",
    "ci:plan": "node tools/ci/select.mjs",
    "perf:budget": "PERF_GRAPHICS=medium,low PERF_SECONDS=4 PERF_MAX_DRAWS=900 PERF_STALL_S=240 node tools/perf/perf96.mjs frost_basin",
    "content:build": "node tools/content/build.mjs",
    "content:check": "node tools/content/build.mjs --check",
    "dev:hub": "pnpm --filter @tiletrigger/server hub",
    "dev:peer": "pnpm --filter @tiletrigger/server hub"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "^22.19.0",
    "meshoptimizer": "^1.3.0",
    "peer": "1.0.2",
    "playwright": "1.56.1",
    "pngjs": "7.0.0",
    "sharp": "0.35.5",
    "three": "0.170.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
